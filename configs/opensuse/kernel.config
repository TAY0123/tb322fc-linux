# F2FS's Android formatting profile uses internal v2 quota files.
CONFIG_QFMT_V2=y
# firewalld's default reverse-path filtering uses nftables FIB expressions.
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
# Landscape text console with a readable built-in font on the 3K panel.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
