From: h0cheung <hcheunh@gmail.com>
Subject: drm: allow a boot orientation override for internal tablet panels

--- a/src/plugins/renderers/drm/plugin.c
+++ b/src/plugins/renderers/drm/plugin.c
@@ -549,6 +549,28 @@
                 drmModeFreeProperty (prop);
         }
 
+        /* A tablet's preferred boot orientation can differ from its native
+         * panel orientation. Leave external displays and the DRM property
+         * unchanged; rotate Plymouth's own pixel buffer for internal panels.
+         */
+        if (connector->connector_type == DRM_MODE_CONNECTOR_DSI ||
+            connector->connector_type == DRM_MODE_CONNECTOR_eDP) {
+                switch (ply_kernel_command_line_get_ulong ("plymouth.panel-rotation=", -1)) {
+                case 0:
+                        output->rotation = PLY_PIXEL_BUFFER_ROTATE_UPRIGHT;
+                        break;
+                case 90:
+                        output->rotation = PLY_PIXEL_BUFFER_ROTATE_CLOCKWISE;
+                        break;
+                case 180:
+                        output->rotation = PLY_PIXEL_BUFFER_ROTATE_UPSIDE_DOWN;
+                        break;
+                case 270:
+                        output->rotation = PLY_PIXEL_BUFFER_ROTATE_COUNTER_CLOCKWISE;
+                        break;
+                }
+        }
+
         /* If the firmware setup the plane to use hw 180° rotation, then we keep
          * the hw rotation. This avoids a flicker and avoids the splash turning
          * upside-down when mutter turns hw-rotation back on and then fades from
