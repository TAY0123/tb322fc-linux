+def kernel_metadata(config, modules):
+    """Only use the versioned inputs owned by the installed Freedom RPM."""
+    path = modules / 'tb322fc-build.json'
+    if not path.is_file():
+        return None
+    data = json.loads(path.read_text())
+    if data['package'] != config['pkgbase']:
+        return None
+    if data['release'] != modules.name:
+        raise ValueError('Kernel metadata does not match the module directory')
+    owner = subprocess.run(['rpm', '-qf', '--qf', '%{NAME}\\n', '--', str(path)],
+                           capture_output=True, text=True, timeout=10)
+    if owner.returncode == 1:
+        return None
+    owner.check_returncode()
+    return data if owner.stdout.strip() == config['pkgbase'] else None
+
