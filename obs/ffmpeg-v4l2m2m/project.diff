@@ -668,9 +673,20 @@
 	--disable-decoder=h264,hevc,vc1,prores_raw,vvc \
 	--enable-encoder="$(perl -pe 's{^(\w*).*}{$1,}gs' <%_sourcedir/enable_encoders)" \
