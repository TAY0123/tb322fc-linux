# Generated by obs/prepare-simple.py from the maintained device source recipe.
Name:           armada-rgb
Version:        0.1.0
Release:        1
Summary:        Armada RGB controller with Lenovo Y700 Gen4 / G9 2026 support
License:        GPL-3.0-or-later
URL:            https://github.com/h0cheung/tb322fc-linux
Source0:        armada-rgb-0.1.0-local.tar.xz
Source1:        service-sources.json
Source2:        extract-service-sources.py
Source3:        vendor.tar.zst
ExclusiveArch:  aarch64
%global debug_package %{nil}
BuildRequires:  bash
BuildRequires:  python3
BuildRequires:  patch
BuildRequires:  systemd-rpm-macros
BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  gcc
BuildRequires:  pkgconfig
Requires:       glibc
Requires:       libgcc_s1
Requires:       libstdc++6

BuildRequires:  zstd

%description
Device integration from tb322fc-linux, packaged for Tumbleweed. Firmware and
per-device calibration are provisioned separately. Hardware validation of
this RPM port is pending.

%prep
%setup -q -n armada-rgb-0.1.0
python3 %{SOURCE2} %{_sourcedir} %{SOURCE1}
tar -xf %{SOURCE3}
bash recipe-stage.sh prepare

%build
export RUSTFLAGS="${RUSTFLAGS:-} %{?tb322fc_rustflags}"
export CFLAGS="%{optflags}" CXXFLAGS="%{optflags}"
bash recipe-stage.sh build

%install
bash recipe-stage.sh install %{buildroot}
python3 file-list.py %{buildroot} > files.list

%check
export RUSTFLAGS="${RUSTFLAGS:-} %{?tb322fc_rustflags}"
bash recipe-stage.sh check

%files -f files.list
%defattr(-,root,root)

%changelog
