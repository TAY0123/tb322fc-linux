# Maintainer: h0cheung <hcheunh@gmail.com>
# Upstream: https://github.com/armada-os/armada (GPL-2.0-or-later, Copyright the Armada contributors;
# the bundled Valve Steam client keeps Valve's own terms).
pkgname=steam-bootstrap
pkgver=1788652215
pkgrel=7
pkgdesc="Fetch and bootstrap Valve's official ARM64 Steam client into the user's home"
arch=('aarch64')
url="https://github.com/armada-os/armada"
license=('GPL-2.0-or-later')
depends=('python' 'curl' 'unzip' 'xorg-server-xvfb' 'file' 'gtk2' 'openal' 'lsof' 'kde-cli-tools' 'kdialog')
# The manifest pins every client package by SHA256, so the bootstrap state is
# reproducible; the client self-updates from Valve afterwards. Bump pkgver (and
# steam-bootstrap.env) to re-pin.
source=(
    'steam-bootstrap'
    'fetch.py'
    'verify.py'
    'steam-bootstrap.env'
    'manifest-1788652215'
    'launch-steam'
    'steam'
    'steam.desktop'
    'steamos-add-to-steam'
    'add-to-steam-servicemenu.desktop'
    'add-to-steam-kickeraction.desktop'
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    install -d "$pkgdir/usr/lib/steam-bootstrap/manifests"
    install -m755 "$srcdir/steam-bootstrap" "$pkgdir/usr/lib/steam-bootstrap/steam-bootstrap"
    install -m644 "$srcdir/fetch.py" "$pkgdir/usr/lib/steam-bootstrap/fetch.py"
    install -m644 "$srcdir/verify.py" "$pkgdir/usr/lib/steam-bootstrap/verify.py"
    install -m644 "$srcdir/steam-bootstrap.env" "$pkgdir/usr/lib/steam-bootstrap/steam-bootstrap.env"
    install -m644 "$srcdir/manifest-1788652215" \
        "$pkgdir/usr/lib/steam-bootstrap/manifest-1788652215"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/steam-bootstrap/steam-bootstrap "$pkgdir/usr/bin/steam-bootstrap"
    # The launcher the gamescope session, Steam's generated shortcuts and
    # steam:// handlers all resolve `steam` to.
    install -d "$pkgdir/usr/share/applications"
    install -m755 "$srcdir/launch-steam" "$pkgdir/usr/lib/steam-bootstrap/launch-steam"
    install -m755 "$srcdir/steam" "$pkgdir/usr/bin/steam"
    install -m644 "$srcdir/steam.desktop" \
        "$pkgdir/usr/share/applications/steam.desktop"
    install -m755 "$srcdir/steamos-add-to-steam" "$pkgdir/usr/bin/steamos-add-to-steam"
    install -Dm644 "$srcdir/add-to-steam-servicemenu.desktop" \
        "$pkgdir/usr/share/kio/servicemenus/tb322fc-add-to-steam.desktop"
    install -Dm644 "$srcdir/add-to-steam-kickeraction.desktop" \
        "$pkgdir/usr/share/plasma/kickeractions/tb322fc-add-to-steam.desktop"
}
