#!/usr/bin/env python3
"""Select Android for recovery/bootloader requests; preserve the slot on power-off."""
import argparse
import os
from pathlib import Path
import stat
import struct
import subprocess

SLOTCTL = '/usr/local/libexec/tb322fc-select-boot-slot'
REBOOT_PARAMETER = Path('/run/systemd/reboot-param')


def requested_android_mode(action, parameter):
    if action == 'poweroff':
        return None
    if action == 'reboot' and parameter in ('bootloader', 'recovery', 'fastboot'):
        return parameter
    return None


def read_reboot_parameter():
    try:
        info = REBOOT_PARAMETER.lstat()
    except FileNotFoundError:
        return ''
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('Unsafe systemd reboot parameter file')
    if info.st_size > 128:
        raise RuntimeError('Oversized systemd reboot parameter')
    return REBOOT_PARAMETER.read_text().strip()


def prepare(action, parameter, dry_run=False):
    mode = requested_android_mode(action, parameter)
    if mode is None:
        print(('Power-off' if action == 'poweroff' else 'Ordinary reboot') + ': keeping the selected slot.', flush=True)
        return
    # Stock recovery images contain only ramdisks. They require Android boot_a,
    # rather than the Linux kernel and its embedded initramfs in boot_b.
    with Path('/dev/disk/by-partlabel/boot_a').open('rb') as stream:
        header = stream.read(4096)
    if header[:8] != b'ANDROID!' or struct.unpack_from('<I', header, 40)[0] != 4:
        raise RuntimeError('Android boot_a is not the expected v4 boot image')
    if struct.unpack_from('<I', header, 8)[0] < 1024 * 1024:
        raise RuntimeError('Android boot_a lacks its kernel')
    command = [SLOTCTL, 'select', 'a']
    if dry_run:
        command.append('--dry-run')
    subprocess.run(command, check=True, timeout=100)
    print(('Would prepare' if dry_run else 'Prepared') + f' Android slot A for {mode}; no partition images changed.', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['reboot', 'poweroff'])
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--parameter', help='Dry-run override of systemd reboot parameter')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run as root')
    if args.parameter is not None and not args.dry_run:
        parser.error('--parameter is allowed only with --dry-run')
    parameter = args.parameter if args.parameter is not None else read_reboot_parameter() if args.action == 'reboot' else ''
    prepare(args.action, parameter, args.dry_run)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(f'Android boot-mode preparation failed: {error}')
