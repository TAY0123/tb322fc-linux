#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Recreate the daemon and FunctionFS after resume, preserving a stopped service.
# Queue the restart so sleep hooks do not wait for another systemd job.
if [ "$1" = post ]; then
    /usr/bin/systemctl --no-block try-restart tb322fc-adbd.service
fi
