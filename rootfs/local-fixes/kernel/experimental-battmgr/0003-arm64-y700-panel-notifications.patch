Subject: [EXPERIMENTAL] arm64: dts: qcom: y700: opt into experimental panel notification control

Prepare an opt-in hardware experiment against the installed Y700 kernel.
Reliable notification suppression during deep suspend remains unverified.

---

diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-elden.dts
@@ -659,6 +659,8 @@
 		#size-cells = <0>;
 		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
 		qcom,battery-current-inverted;
+		/* Experimental vendor-style battery notification policy. */
+		panel = <&panel0>;
 
 		/* Long edge */
 		connector@0 {
