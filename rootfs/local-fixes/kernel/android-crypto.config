# Delta for the legacy kernel at 87834e9d970dff2cd6329f585ee68eb17b182e4e.
# This enables kernel support, not provisioning of Android wrapped keys.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=m
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_CRYPTO_XTS=y
